{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thomasfevre.github.io/agent-memory-bench/schemas/public-registry.schema.json",
  "title": "Agent Memory Bench public registry",
  "type": "object",
  "required": ["schema_version", "updated_at", "campaign", "workflow", "runs", "systems", "findings", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "updated_at": {"type": "string", "format": "date"},
    "campaign": {
      "type": "object",
      "required": ["title", "repository", "principle", "constraints"],
      "properties": {
        "title": {"type": "string"},
        "repository": {"type": "string"},
        "principle": {"type": "string"},
        "constraints": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "workflow": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "label", "description"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "date", "phase", "dataset", "task", "method", "reader", "evidence_level", "sample", "repetitions", "metrics", "budget", "conclusion", "limitation", "evidence_files"],
        "properties": {
          "id": {"type": "string"},
          "date": {"type": "string", "format": "date"},
          "phase": {"enum": ["implementation", "ingestion", "retrieval", "generation", "agentic", "durability"]},
          "dataset": {"type": "string"},
          "task": {"type": "string"},
          "method": {"type": "string"},
          "reader": {"type": ["string", "null"]},
          "evidence_level": {"enum": ["controlled", "official-data", "smoke", "timeout", "not-reproduced"]},
          "sample": {"type": "string"},
          "repetitions": {"type": "integer", "minimum": 0},
          "metrics": {"type": "object", "minProperties": 1},
          "budget": {"type": "object", "minProperties": 1},
          "conclusion": {"type": "string"},
          "limitation": {"type": "string"},
          "evidence_files": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "systems": {"type": "array", "items": {"type": "object"}},
    "findings": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
